ORCHESTRATOR_COST_CAP_USD=50
ORCHESTRATOR_AGENT_TIMEOUT_MS=2700000
ORCHESTRATOR_HTTP_HOST=127.0.0.1
ORCHESTRATOR_HTTP_PORT=4373
ORCHESTRATOR_VAULT_PATH=./.vault
ORCHESTRATOR_WORKTREE_BASE=./worktrees
ORCHESTRATOR_GITHUB_REPOSITORY=WitherGH/CRM-orchestrator-beta-0.1

# Per-role model routing. Codex roles default to GPT-5.5.
ORCHESTRATOR_ARCHITECT_RUNNER=claude
ORCHESTRATOR_ARCHITECT_MODEL=claude-opus-4.7
ORCHESTRATOR_DESIGNER_RUNNER=claude
ORCHESTRATOR_DESIGNER_MODEL=claude-sonnet-4.6
ORCHESTRATOR_PM_RUNNER=claude
ORCHESTRATOR_PM_MODEL=claude-sonnet-4.6
ORCHESTRATOR_REVIEWER_RUNNER=claude
ORCHESTRATOR_REVIEWER_MODEL=claude-opus-4.7
ORCHESTRATOR_DEVELOPER_RUNNER=codex
ORCHESTRATOR_DEVELOPER_MODEL=gpt-5.5
ORCHESTRATOR_TESTER_RUNNER=codex
ORCHESTRATOR_TESTER_MODEL=gpt-5.5

# Console-only reset hints. Accepted formats:
# - compact: gpt-5.5=17:00,claude-opus-4.7=17:00
# - JSON: {"gpt-5.5":"17:00","claude-opus-4.7":"2026-05-14T17:00:00+03:00"}
ORCHESTRATOR_MODEL_LIMIT_RESETS=gpt-5.5=17:00,claude-opus-4.7=17:00,claude-sonnet-4.6=17:00
